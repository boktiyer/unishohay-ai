# The chat uses open-weight models through Vercel AI Gateway.
# On Vercel, authentication is automatic (OIDC), so no key is needed.
# For local development outside Vercel, run `vercel env pull` or set AI_GATEWAY_API_KEY.
# Optional: comma-separated model list (first = primary, rest = fallbacks).
AI_MODELS=openai/gpt-oss-120b,meta/llama-4-maverick,deepseek/deepseek-v4-flash
